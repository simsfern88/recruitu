# ---- Secrets & environment ----
# NEVER commit API keys or credentials. Your Anthropic API key goes in .env,
# which stays out of git.
.env
.env.*
*.pem
*.key
secrets/
credentials*.json

# ---- Node / JavaScript ----
node_modules/
dist/
build/
.next/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Local uploads / user data (never commit real student data) ----
uploads/
user-data/
*.local
