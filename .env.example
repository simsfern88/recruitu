# App connection — a NON-superuser, non-BYPASSRLS role so RLS policies apply.
DATABASE_URL=postgresql://recruitu_app:app_password@localhost:5432/recruitu

# Admin/owner connection — used ONLY for migrations, grants, and RLS setup.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitu

# Server-side only. Never expose to the client.
ANTHROPIC_API_KEY=sk-ant-...
